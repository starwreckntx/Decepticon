# LLM API
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key

# Langsmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your-api-key
LANGSMITH_PROJECT=Decepticon
LANGGRAPH_API_URL=http://127.0.0.1:2024

# --- KKI governance (governed_recon MCP server) ---
# Path to the kali-kimi-interface checkout (omit if it is a sibling of this repo).
KKI_PATH=../kali-kimi-interface
# Engagement scope: comma-separated CIDRs the swarm is authorized to touch. STRONGLY
# recommended — without it the network-scope gate is advisory only.
KKI_NETWORK_SCOPE=192.168.56.0/24
# Consent strategy for DANGER actions: broker (out-of-band human approval) | deny | preauth
KKI_CONSENT_MODE=broker
# Out-of-band consent spool dir (operator approves via `python -m kki_gov.consent_broker`).
# Leave unset to use the secure per-user default (<tmpdir>/kki-consent-<user>, created 0700).
# KKI_CONSENT_DIR=/run/user/1000/kki-consent
# Where to persist the tamper-evident audit trail when the server shuts down.
KKI_AUDIT_PATH=./logs/kki-audit.json
# Operator id stamped into audit entries.
KKI_OPERATOR_ID=operator
# Only honored when KKI_CONSENT_MODE=preauth: accept responsibility for unattended,
# in-scope DANGER actions (every other gate still applies). Leave unset to stay safe.
# KKI_SESSION_AUTHORIZED=1

# --- Governance gateway (single-chokepoint deploy) ---
GATEWAY_PORT=3000
GATEWAY_ENFORCE_AGENT=1
# Identity: "token" (secure; identity from the per-agent connection token, spoof-proof) or
# "trust-arg" (dev only; honors the self-asserted agent argument — spoofable).
GATEWAY_IDENTITY_MODE=token
# Gateway secret mapping token->role, produced by: python -m governance_gateway.identity --mint
# (gitignored). Then launch the swarm with MCP_CONFIG=mcp_config.gateway.tokens.json.
GATEWAY_TOKENS_FILE=gateway_tokens.json
# Selects the MCP topology the loader reads (set to the minted per-agent config to use tokens).
MCP_CONFIG=mcp_config.gateway.json
# Where the agent-integrity chain is persisted on gateway shutdown.
SWARM_INTEGRITY_AUDIT_PATH=./logs/agent-audit.json
# Kernel egress jail (gateway container): 1=fail-closed (must apply nftables scope rules),
# warn=best-effort, 0=software-only scope. Driven by KKI_NETWORK_SCOPE (single source of truth).
EGRESS_ENFORCE=1
# Optional DNS resolver(s) to permit through the egress jail (comma-separated).
# EGRESS_DNS=1.1.1.1
# 1 = add an empty jit_allow nft set the pre-auth broker grants single destinations into.
EGRESS_JIT=0

# --- Preventive pre-authorization (stop it before the damage) ---
# Write-ahead commit + action-bound capability token + just-in-time egress. Execution is
# gated on the token, so nothing runs without the broker's signed yes and the record precedes
# the act. 1=on.
PREAUTH_ENABLE=1
# Token time-to-live (seconds). Short = tighter window.
PREAUTH_TTL=10
# 1 = also open per-action KERNEL egress grants (requires EGRESS_JIT=1). 0 = software token gate only.
PREAUTH_JIT_NFT=0
# Stable signing key so tokens verify across restarts (leave blank for an ephemeral key).
# PREAUTH_SECRET=change-me-to-a-long-random-string